# ==========================================
# GAMEEARN PRO ENVIRONMENT CONFIGURATION
# ==========================================

# ------------------------------------------
# 1. CLIENT-SIDE FIREBASE WEB AUTHENTICATION (Public / Vite)
# ------------------------------------------
# Set these in your Vercel Project Settings -> Environment Variables.
# These variables configure the Firebase Web SDK for live SMS OTP Phone Authentication.
# (Note: These are public client identifiers and are safe in frontend code).
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseWebApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="your-gameearn-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-gameearn-project"
VITE_FIREBASE_STORAGE_BUCKET="your-gameearn-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# ------------------------------------------
# 2. SERVER-SIDE CREDENTIALS (Confidential - Never prefix with VITE_)
# ------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g., https://your-app.vercel.app)
APP_URL="http://localhost:3000"

# PORT: Server listening port for local Node runtime (defaults to 3000)
PORT="3000"

# PAYMENT GATEWAY SANDBOX (RazorpayX / Cashfree Payouts)
RAZORPAYX_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAYX_KEY_SECRET="YOUR_TEST_KEY_SECRET"
RAZORPAYX_ACCOUNT_NUMBER="7878780012345678"
RAZORPAYX_WEBHOOK_SECRET="YOUR_WEBHOOK_SECRET"

# FIREBASE ADMIN SERVICE ACCOUNT (Server-side only)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgk...YOUR_KEY...\n-----END PRIVATE KEY-----\n"
